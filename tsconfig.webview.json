{
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "resolveJsonModule": true,
    "types": []
  },
  "include": ["src/webview/**/*.ts", "src/preview/**/*.ts", "src/shared/**/*.ts", "src/core/**/*.ts", "src/i18n/**/*.ts", "src/host/session.ts", "src/preview/*.d.ts"]
}
